# Add to /etc/mcpanel/mcpanel.env after adapting paths. No secrets belong in Git.
ASPNETCORE_URLS=http://0.0.0.0:6050
Panel__RequireHttps=true
Panel__TrustedProxies__0=127.0.0.1
Panel__TrustedProxies__1=::1
AllowedHosts=mcpanel.home.arpa
Panel__ReplicationDirectory=/mnt/mcpanel-offhost
Panel__RecoveryIntervalMinutes=30
Panel__AlertWebhookFile=/etc/mcpanel/alert-webhook
Panel__ReservedDiskBytes=1073741824
Panel__BackupRetentionCount=48
Panel__BackupRetentionDays=7
Panel__BackupRetentionBytes=107374182400
Panel__MaxBackupBytes=1099511627776
Panel__MaxBackupEntries=2000000
